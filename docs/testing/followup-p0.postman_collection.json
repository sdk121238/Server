            "url": "{{baseUrl}}/captures",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{captureId}}\",\n  \"lesionId\": \"{{lesionId}}\",\n  \"imageFileId\": \"{{fileId}}\",\n  \"capturedAt\": 1700000000000,\n  \"deviceModel\": \"Postman-Debug\",\n  \"source\": \"GALLERY\",\n  \"assetKind\": \"CAPTURE_IMAGE\",\n  \"referenceOnly\": false,\n  \"qualityNote\": \"合成图片，仅用于接口联调\",\n  \"calibration\": null,\n  \"analysis\": null,\n  \"annotation\": null,\n  \"metadata\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
