    {
      "name": "03 图片上传与采集",
      "description": "按顺序逐条发送。第03条需要手动选取附件图片；请在上传签名到期前完成 PUT。",
      "item": [
        {
          "name": "01 创建单文件上传会话",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_uploadCreate}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/file-uploads",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"sizeBytes\": 83,\n  \"sha256\": \"0aedc9bece813993a4241852d4826e275f95d7cd3877a25e052922f2b84e3c0c\",\n  \"mimeType\": \"image/png\",\n  \"width\": 20,\n  \"height\": 20,\n  \"strategy\": \"SINGLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idem_uploadCreate')) pm.collectionVariables.set('idem_uploadCreate', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('uploadId', data.id);",
                  "pm.collectionVariables.set('fileId', data.fileId);",
                  "pm.collectionVariables.set('uploadUrl', data.uploadUrl);",
                  "pm.collectionVariables.set('uploadContentType', data.requiredHeaders['Content-Type']);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 查询上传会话并更新签名",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/file-uploads/{{uploadId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('uploadId', data.id);",
                  "pm.collectionVariables.set('fileId', data.fileId);",
                  "pm.collectionVariables.set('uploadUrl', data.uploadUrl);",
                  "pm.collectionVariables.set('uploadContentType', data.requiredHeaders['Content-Type']);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 PUT 测试图片（Body 选择 binary 文件）",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{uploadContentType}}"
              }
            ],
            "url": "{{uploadUrl}}",
            "description": "Body → binary → 选择 docs/testing/sample-20x20.png。必须上传原始文件，保持 Content-Type=image/png。",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
