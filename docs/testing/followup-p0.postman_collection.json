    {
      "name": "04 快照与增量同步",
      "description": "",
      "item": [
        {
          "name": "01 创建一致快照",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_snapshotCreate}}"
              }
            ],
            "url": "{{baseUrl}}/sync/snapshots",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idem_snapshotCreate')) pm.collectionVariables.set('idem_snapshotCreate', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set('snapshotId', pm.response.json().id);",
                  "pm.collectionVariables.unset('snapshotPageToken');",
                  "pm.collectionVariables.unset('syncCursor');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 读取快照首页",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sync/snapshots/{{snapshotId}}?limit=100",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('snapshotPageToken', data.nextPageToken || '');",
                  "if (data.nextCursor) pm.collectionVariables.set('syncCursor', data.nextCursor);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 读取快照下一页（有 token 才发送）",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sync/snapshots/{{snapshotId}}?limit=100&pageToken={{snapshotPageToken}}",
            "description": "仅当上一页 nextPageToken 非 null 时发送，重复直到末页拿到 syncCursor。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('snapshotPageToken', data.nextPageToken || '');",
                  "if (data.nextCursor) pm.collectionVariables.set('syncCursor', data.nextCursor);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 拉取增量并更新游标",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sync/changes?limit=100&cursor={{syncCursor}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.collectionVariables.set('syncCursor', pm.response.json().nextCursor);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 按需测试（不要整组运行）",
      "description": "",
      "item": [
        {
          "name": "01 刷新并替换双令牌",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "每次都使用最新 refreshToken；重复旧令牌会撤销整个令牌族。",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('tokenExpiresAt', String(data.expiresAt));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 修改资料",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "If-Match",
                "value": "{{profileEtag}}"
              },
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              }
            ],
            "url": "{{baseUrl}}/users/me",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"接口调试用户\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.collectionVariables.set('profileEtag', pm.response.headers.get('ETag')); ",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 修改登录密码（会更改真实账号）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_passwordChange}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/me/password",
            "description": "先设置本地 newPassword。成功后手动更新 password；其他会话会失效。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idem_passwordChange')) pm.collectionVariables.set('idem_passwordChange', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 创建旧数据导入计划",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_importCreate}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/offline-imports",
            "description": "将返回 importId 与这里的 importPatientId 用于后续 POST /patients；本请求仅创建计划。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientDatasetId\": \"{{clientDatasetId}}\",\n  \"confirmedPatientIds\": [\n    \"{{importPatientId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idem_importCreate')) pm.collectionVariables.set('idem_importCreate', pm.variables.replaceIn('{{$guid}}'));",
                  "if (!pm.collectionVariables.get('clientDatasetId')) pm.collectionVariables.set('clientDatasetId', pm.variables.replaceIn('{{$guid}}'));",
                  "if (!pm.collectionVariables.get('importPatientId')) pm.collectionVariables.set('importPatientId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set('importId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 上传续签（仅完成前）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idem_uploadSign}}"
              }
            ],
            "url": "{{baseUrl}}/file-uploads/{{uploadId}}/sign-single",
            "description": "每次需要全新的签名时清空 idem_uploadSign。会话 READY 后返回409。"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idem_uploadSign')) pm.collectionVariables.set('idem_uploadSign', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('uploadUrl', data.url);",
                  "pm.collectionVariables.set('uploadContentType', data.requiredHeaders['Content-Type']);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 中止上传（仅未确认会话）",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/file-uploads/{{uploadId}}",
            "description": "会中止当前 uploadId，不要在正式上传流程中误发；READY 会返回409。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 查询未知任务（预期404）",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/jobs/{{jobId}}",
            "description": ""
